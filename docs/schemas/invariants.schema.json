{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"invariants.schema.json","title":"Invariants（invariants.yaml：G1 安全不變量規格）","description":"W0.5 產出、G1 由應用擁有者核准。invariants[] 是 source＝invariant 的需求；baseline[] 是採用的 ASVS／AISVS 基準需求（只列 ID 與層級，不複製標準原文）。baseline_levels 是整體採用的層級；level_triggers 讓特定功能對特定章節提高層級：任何 L2 以上的 ASVS／AISVS 需求都必須被其中之一涵蓋（E-INVARIANT-LEVEL）。G1 核准的產物 hash＝本檔 approval view（移除 signoff）的 hash。","type":"object","additionalProperties":false,
"properties":{
"engagement_id":{"$ref":"common.schema.json#/$defs/engagement_id"},
"run_id":{"$ref":"common.schema.json#/$defs/run_id"},
"round":{"type":"integer","minimum":1,"maximum":3},
"drafted_by":{"type":"object","additionalProperties":false,"properties":{"agent_id":{"type":"string"},"family":{"type":"string"}},"required":["agent_id","family"],"description":"agents.yaml 中 role invariant_drafter 的代理；family 必須等於登錄推導的家族（E-PROVENANCE）"},
"baseline_levels":{"type":"object","additionalProperties":false,"properties":{"asvs":{"type":"integer","minimum":1,"maximum":3},"aisvs":{"type":"integer","minimum":1,"maximum":3}},"required":["asvs","aisvs"],"description":"整體採用的 ASVS／AISVS 層級（1–3）"},
"level_triggers":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"feature":{"type":"string","description":"觸發的功能：invariants[].applies_to_features 或 W0 inventory features 之一"},"standard":{"enum":["asvs","aisvs"]},"level":{"enum":[2,3]},"sections":{"type":"array","items":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)*$"},"minItems":1,"description":"章節前綴，例如 8.2 涵蓋 8.2.3"}},"required":["feature","standard","level","sections"]}},
"baseline":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"requirement_id":{"type":"string"},"source":{"enum":["asvs-5.0.0","aisvs-1.0"]},"ref":{"type":"string","description":"v5.0.0-8.2.2（ASVS）或 v1.0-9.5.2（AISVS）"},"level":{"anyOf":[{"enum":["L1","L2","L3"]},{"type":"null"}]}},"required":["requirement_id","source","ref","level"]}},
"access_matrix":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"role":{"type":"string"},"resource":{"type":"string"},"actions":{"type":"array","items":{"enum":["read","create","update","delete","invoke"]}},"ownership":{"type":"object","additionalProperties":false,"properties":{"kind":{"enum":["none","owner_field","tenant_field","membership"]},"field":{"anyOf":[{"type":"string"},{"type":"null"}]},"via":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["kind","field","via"],"description":"可機械檢查的擁有權條件；kind none 時 field／via 為 null"},"condition":{"type":"string","description":"給人看的說明"}},"required":["role","resource","actions","ownership","condition"]}},
"data_classification":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"data_class_id":{"type":"string","pattern":"^DC-[A-Z0-9-]+$"},"name":{"type":"string"},"level":{"enum":["public","internal","confidential","restricted"]},"fields":{"type":"array","items":{"type":"string"}},"pii":{"type":"boolean"}},"required":["data_class_id","name","level","fields","pii"]},"description":"受測應用的資料分級（與工具包自己的 data_class P／C 不同）"},
"llm_tools":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"tool_name":{"type":"string"},"side_effect":{"enum":["none","read","write","external"]},"requires_human_confirmation":{"type":"boolean"},"allowed_roles":{"type":"array","items":{"type":"string"}},"data_class_ids":{"type":"array","items":{"type":"string"},"description":"data_classification 的 ID（E-INVARIANT-REF）"}},"required":["tool_name","side_effect","requires_human_confirmation","allowed_roles","data_class_ids"]},"description":"受測 LLM 功能的工具權限矩陣"},
"limits":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"limit_id":{"type":"string","pattern":"^LIM-[0-9]{3,}$"},"subject":{"type":"string"},"metric":{"type":"string"},"value":{"type":"number"},"scope":{"enum":["per_user","per_tenant","global"]}},"required":["limit_id","subject","metric","value","scope"]}},
"policies":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"policy_id":{"type":"string","pattern":"^POL-[0-9]{3,}$"},"kind":{"enum":["cors_allowlist","redirect_allowlist","upload_types","outbound_hosts","webhook_signature","csp","other"]},"values":{"type":"array","items":{"type":"string"}}},"required":["policy_id","kind","values"]}},
"invariants":{"type":"array","items":{"$ref":"requirement.schema.json"},"minItems":1},
"signoff":{"type":"object","additionalProperties":false,"properties":{"gate_record_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"enum":["PENDING","ACCEPTED","REJECTED","NEEDS_INFO"]}},"required":["gate_record_id","status"]}},
"required":["engagement_id","run_id","round","drafted_by","baseline_levels","level_triggers","baseline","access_matrix","data_classification","llm_tools","limits","policies","invariants","signoff"]}
