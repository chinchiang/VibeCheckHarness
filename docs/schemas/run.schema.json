  ],
  "$defs": {
    "gate_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "$ref": "common.schema.json#/$defs/gate"
        },
        "gate_record_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^GR-[0-9A-Za-z-]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "EXPIRED 時為 null"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/gate_outcome"
            },
            {
              "type": "null"
            }
          ],
          "description": "null＝關卡已開啟、尚未決定（此時 gate_record_id 與 decided_at 也是 null）"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "subject_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "opened_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "decided_at": {
          "$ref": "common.schema.json#/$defs/datetime_or_null"
        }
      },
      "required": [
        "gate",
        "gate_record_id",
        "outcome",
        "round",
        "subject_hash",
        "job_id",
        "opened_at",
        "decided_at"
      ]
    },
    "phase_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_compute_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "spent_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "spent_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "spent_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "compute_minutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_usd",
        "max_compute_minutes",
        "spent_input_tokens",
        "spent_output_tokens",
        "spent_cost_usd",
        "compute_minutes"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string"
        },
        "testcase_id": {
          "type": "string"
        },
        "safety_class": {
          "enum": [
            "S0",
            "S1",
            "S2"
          ]
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/target_id"
        },
        "status": {
          "enum": [
            "PENDING",
            "AWAITING_G5",
            "SNAPSHOTTED",
            "EXECUTING",
            "EXECUTED",
            "INTERRUPTED",
            "RESTORED",
            "RESTORE_FAILED",
            "SKIPPED",
            "STOPPED"
          ]
        },
        "g5_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore_verified": {
          "type": "boolean"
        },
        "result_ref": {
          "$ref": "common.schema.json#/$defs/sha256_or_null"
        },
        "skip_reason": {
          "anyOf": [
            {
              "enum": [
                "g4_rejected",
                "g5_rejected",
                "g5_expired",
                "no_snapshot",
                "ownership_failed",
                "seed_reset_failed",
                "outside_window",
                "stopped",
                "build_mismatch",
                "session_unavailable",
                "login_unavailable",
                "seed_setup_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "testcase_id",
        "safety_class",
        "target_id",
        "status",
        "g5_record_id",
        "snapshot_ref",
        "restore_verified",
        "result_ref",
        "skip_reason"
      ]
    }
  }
