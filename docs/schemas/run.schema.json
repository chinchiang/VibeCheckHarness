{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Run（run 紀錄，RunState 的持久化子集）",
  "description": "欄位對應 docs/03 §5.1 RunState。只存參照（sha256: 或 Blackboard ID）。授權一律以 gate_records 指向的簽章紀錄為準，不以本紀錄或 checkpoint 內容為準。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "engagement_id": {
      "$ref": "common.schema.json#/$defs/engagement_id"
    },
    "run_kind": {
      "enum": [
        "initial",
        "followup",
        "regression",
        "lane_a"
      ]
    },
    "parent_run_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/run_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "followup／regression 必填"
    },
    "baseline_run_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/run_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "B9：比較叢集指紋的基準 run（SARIF baselineState）；null＝沒有基準，叢集的 baseline_state 為 null"
    },
    "reuse": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "description": "沿用的上一 run 產物（輸入 hash 必須相同）"
    },
    "trigger": {
      "enum": [
        "manual",
        "schedule",
        "merge",
        "pull_request"
      ]
    },
    "run_owner": {
      "$ref": "common.schema.json#/$defs/person_id"
    },
    "initiators": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/person_id"
      },
      "description": "啟動者、認領者、G4 核准者；都必須是人"
    },
    "status": {
      "enum": [
        "RUNNING",
        "WAITING_GATE",
        "SUSPENDED",
        "STOPPED",
        "ABORTED",
        "FAILED",
        "COMPLETED",
        "COMPLETED_WITH_GAPS"
      ]
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_node": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_node": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_deadline": {
      "$ref": "common.schema.json#/$defs/datetime_or_null",
      "description": "min(委任 not_after, ROE not_after)"
    },
    "data_class": {
      "$ref": "common.schema.json#/$defs/data_class"
    },
    "toolkit_config_ref": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "key_registry_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "engagement_ref": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "config_refs": {
      "type": "object",
      "additionalProperties": false,
      "description": "B11：本 run 使用的設定檔路徑與 content hash（validator 由檔案重算；E-DERIVED／E-RUN-CONFIG）。v0.5：models、agents、tools、calibration 在 run_init 就必須已產生；invariants、seed_manifest 依 run 已到達的節點可以是 pending 或 not_applicable",
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "invariants": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "pending"
                },
                "expected_node": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "expected_node"
              ],
              "description": "尚未產生：產生節點還沒完成（例如 G1 前的 invariants、G0b 前的 seed_manifest）"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "reason"
              ],
              "description": "不適用：本 run 的階段計畫用不到（例如純白箱 run 或 Lane A 的 seed_manifest）"
            }
          ],
          "description": "v0.5（BL-22／BL-23）：已產生＝{path, sha256}；尚未產生＝{state: pending, expected_node}；不適用＝{state: not_applicable, reason}。「應存在但遺失」由 validator 判定（產生節點已完成卻仍是 pending，E-RUN-CONFIG）"
        },
        "seed_manifest": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "pending"
                },
                "expected_node": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "expected_node"
              ],
              "description": "尚未產生：產生節點還沒完成（例如 G1 前的 invariants、G0b 前的 seed_manifest）"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "reason"
              ],
              "description": "不適用：本 run 的階段計畫用不到（例如純白箱 run 或 Lane A 的 seed_manifest）"
            }
          ],
          "description": "v0.5（BL-22／BL-23）：已產生＝{path, sha256}；尚未產生＝{state: pending, expected_node}；不適用＝{state: not_applicable, reason}。「應存在但遺失」由 validator 判定（產生節點已完成卻仍是 pending，E-RUN-CONFIG）"
        }
      },
      "required": [
        "models",
        "agents",
        "tools",
        "calibration",
        "invariants",
        "seed_manifest"
      ]
    },
    "prompt_templates": {
      "type": "array",
      "description": "本 run 使用的 prompt 範本版本；slice.prompt_template_sha256 必須是其中之一（E-SLICE-IDENTITY）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "anonymizes_candidates": {
            "type": "boolean",
            "description": "v0.4：此範本在送出前去除候選的來源模型資訊（W3 verifier 範本必須為 true）。votes[].anonymized 由這裡推導，不採信票上的值"
          },
          "randomizes_order": {
            "type": "boolean",
            "description": "v0.4：此範本隨機排列候選順序（W3 verifier 範本必須為 true）。votes[].order_randomized 由這裡推導"
          }
        },
        "required": [
          "template_id",
          "version",
          "sha256"
        ]
      }
    },
    "tool_versions": {
      "type": "array",
      "description": "本 run 使用的工具版本；adapter 必須在 tools.yaml，且與稽核 tool_invocation 的 payload.tool_version 一致（E-RUN-CONFIG）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "$ref": "common.schema.json#/$defs/tool_mode"
          },
          "version": {
            "type": "string"
          },
          "image_digest": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "adapter",
          "version",
          "image_digest"
        ]
      }
    },
    "rule_version": {
      "type": "string",
      "description": "裁決規則版本（docs/05）；必須等於 vchlib.adjudicate.RULE_VERSION 與本 run 每個裁決的 rule_version（E-RUN-RULE-VERSION）"
    },
    "roe_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "repo_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "owasp_llm_version": {
      "anyOf": [
        {
          "enum": [
            "2025",
            "2026"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "B2 實際使用的 OWASP LLM 版本（委任設定或 toolkit 預設）；W-only 與 Lane A 為 null"
    },
    "calibration_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "裁決所用的校準版本（calibration.yaml calibration_version）"
    },
    "inventory_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "sbom_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "w4_manual_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement_id",
          "reason"
        ]
      },
      "description": "v0.5（BL-27，docs/02 W4 完成條件）：沒有 W4 測試、改以 MANUAL 處理的 G1 不變量與原因。run 有 W4 產物或種子威脅後，每條 G1 核准的不變量都要有 W4 測試案例或列在這裡，不能兩者都有（E-W4-COVERAGE）"
    },
    "tool_results_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null",
      "description": "v0.5（BL-13）：W1 正規化後的 ToolResult 清單參照＝sha256(JCS(本 run 稽核紀錄中 W1、Z2 的 tool_invocation_end 事件之 payload_refs，去重排序))；沒有這類事件時為 null（writer 導出，E-DERIVED）"
    },
    "redaction_map_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null",
      "description": "null 時 Gateway 拒絕此 run 的所有 LLM 請求"
    },
    "invariants_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "invariants_changed": {
      "type": "boolean"
    },
    "g1_round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "w1_sarif_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "deps_check_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "slice_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "plan_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{3,}$"
      }
    },
    "cluster_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{3,}$"
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "每一版裁決都保留（append-only）"
    },
    "missing_votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "cluster_id",
          "agent_id",
          "reason"
        ]
      }
    },
    "diversity_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "reason"
        ]
      }
    },
    "cmd2_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "CMD-2 加派輪數；上限 max_extra_dispatch_rounds＝2（E-PLAN-ROUNDS）"
    },
    "g2_queue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "w4_iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "w4_results": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "whitebox_report_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "w_sarif_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "dfd_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "seed_threats_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "lane_a_advisories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lane A 帶入的參考性發現項；不計入 independent_families"
    },
    "disputed_after_g2": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{3,}$"
      },
      "description": "W4_readjudicate 重新裁決時才轉為 DISPUTED 的叢集（G3 另列）。推導值：本 run 中帶 w4_became_disputed 註記之 verdict 的 cluster_id（排序、不重複；docs/05 §4.2）；驗證器（E-DERIVED）比對"
    },
    "egress_allowlist_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "ownership_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "$ref": "common.schema.json#/$defs/target_id"
          },
          "method": {
            "enum": [
              "dns_txt",
              "well_known_path",
              "platform_project"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "checked_at": {
            "$ref": "common.schema.json#/$defs/datetime"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "signed_result_ref": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "target_id",
          "method",
          "ok",
          "checked_at",
          "batch_id",
          "signed_result_ref"
        ]
      }
    },
    "b1_external_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "b1_merged_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "b1_diff_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "taxonomy_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "threat_model_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "b1_diff_dispositions_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "g3_round": {
      "type": "integer",
      "minimum": 0
    },
    "testplan_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "testcase_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "description": "testcase_id → 可執行產物 hash（G4 綁定）"
    },
    "g4_round": {
      "type": "integer",
      "minimum": 0
    },
    "approved_testcase_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restore_drill_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/job"
      },
      "description": "以 job_id 為鍵"
    },
    "executed_jobs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "所有 job 的冪等鍵"
    },
    "stop_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/datetime"
          },
          "scope": {
            "enum": [
              "job",
              "target",
              "run"
            ]
          },
          "condition": {
            "type": "string"
          },
          "observed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/target_id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "at",
          "scope",
          "condition",
          "observed",
          "threshold",
          "job_id",
          "target_id"
        ]
      }
    },
    "kill_switch": {
      "type": "boolean"
    },
    "testresults": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "manual_review_clusters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{3,}$"
      },
      "description": "B5_readjudicate 後轉為 DISPUTED 者（B6 人工複核清單）"
    },
    "followup_drafts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_manifest_ref": {
      "$ref": "common.schema.json#/$defs/sha256_or_null"
    },
    "gate_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate_ref"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_total": {
          "$ref": "#/$defs/phase_budget"
        },
        "W": {
          "$ref": "#/$defs/phase_budget"
        },
        "B": {
          "$ref": "#/$defs/phase_budget"
        },
        "upstream_llm_spend_usd": {
          "type": "number",
          "minimum": 0
        },
        "relay_spend_usd": {
          "type": "number",
          "minimum": 0
        },
        "gb_return_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_total",
        "W",
        "B",
        "upstream_llm_spend_usd",
        "relay_spend_usd",
        "gb_return_node"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "manual",
              "g3_rejected",
              "g4_rejected",
              "g5_skipped",
              "tool_failed",
              "ownership_failed",
              "gb_stopped",
              "seed_reset_failed",
              "error",
              "build_mismatch",
              "teardown_failed",
              "no_lockfile"
            ]
          },
          "ref": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref",
          "reason"
        ]
      },
      "description": "B6「未能測試清單」的來源"
    },
    "audit_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "description": "被錨定的 audit_anchor 事件的 seq（稽核日誌中的行號，從 1 起算）"
          },
          "line_sha256": {
            "$ref": "common.schema.json#/$defs/sha256",
            "description": "該 audit_anchor 事件那一行原始位元組（不含換行）的 sha256，因此錨點涵蓋到它自己那一行為止"
          }
        },
        "required": [
          "seq",
          "line_sha256"
        ]
      },
      "description": "稽核錨點：日誌中每個 audit_anchor 事件依序一筆，seq 嚴格遞增。validator 檢查：每筆的 line_sha256 等於該 seq 那一行的 sha256（E-AUDIT-ANCHOR-MISMATCH）；日誌行數不少於錨定的 seq（E-AUDIT-TRUNCATED）；清單與日誌中的 audit_anchor 事件一一對應（E-AUDIT-ANCHOR）；最後錨點之後的行為未錨定尾段（W-AUDIT-UNANCHORED-TAIL）；終止狀態（COMPLETED、COMPLETED_WITH_GAPS、ABORTED、FAILED）的 run 必須有涵蓋最後一行的最終錨點（E-AUDIT-TAIL）"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string"
          },
          "error_class": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "detail_ref": {
            "$ref": "common.schema.json#/$defs/sha256_or_null"
          }
        },
        "required": [
          "node",
          "error_class",
          "attempt",
          "detail_ref"
        ]
      }
    }
  },
