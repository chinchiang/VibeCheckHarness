{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commander-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "decision_node": {
      "type": "string",
      "enum": [
        "CMD-1",
        "CMD-2",
        "CMD-3",
        "CMD-4",
        "CMD-5"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "CMD-2 加派輪次；上限 max_extra_dispatch_rounds＝2（E-PLAN-ROUNDS）"
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slice_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "authz",
                "authn_session",
                "injection",
                "data_access",
                "secrets_config",
                "business_logic",
                "llm_integration",
                "file_handling",
                "ssrf_outbound",
                "frontend_client",
                "webhooks_integrations",
                "crypto",
                "cicd_iac"
              ]
            },
            "minItems": 1,
            "description": "必須涵蓋 W0 inventory 推導的 MANDATORY_FACETS（E-PLAN-FACETS）"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "agents.yaml 中 role reviewer 的代理（E-PLAN-AGENTS）"
          }
        },
        "required": [
          "slice_id",
          "facets",
          "agents"
        ]
      }
    },
    "extra_dispatch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cluster",
                  "slice",
                  "threat"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "description": "型別化目標：cluster＝K-…、slice＝sha256:…、threat＝T-…；validator 依 kind 檢查格式並解析（E-PLAN-TARGET）"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "agents.yaml 中 role reviewer 或 verifier 的代理（E-PLAN-AGENTS）"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "agents",
          "reason"
        ]
      }
    },
    "taxonomies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stride",
          "linddun",
          "owasp-llm@2025",
          "owasp-llm@2026",
          "owasp-asi@2026",
          "maestro"
        ]
      }
    },
    "testcase_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]+$"
      }
    },
    "budget_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "≤ 該決策節點所屬階段（CMD-1／2→W、CMD-3／4→B、CMD-5→run_total）的 run 預算 max_input_tokens（E-PLAN-BUDGET）"
    },
    "rationale": {
      "type": "string"
    },
    "followup_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "run_kind": {
            "type": "string",
            "enum": [
              "followup",
              "regression"
            ]
          },
          "cluster_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testcase_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "run_kind",
          "cluster_ids",
          "testcase_ids",
          "reason"
        ]
      },
      "description": "只有 CMD-5：追蹤／回歸 run 草稿（需人啟動，不自動執行）"
    }
  },
  "required": [
    "plan_id",
    "decision_node",
    "round",
    "slices",
    "extra_dispatch",
    "taxonomies",
    "testcase_ids",
    "target_ids",
    "budget_tokens",
    "rationale",
    "followup_drafts"
  ],
  "description": "Commander 只能在程式碼產生的覆蓋下限上增加項目；Policy Engine 驗證後才執行。",
  "title": "CommanderPlan（指揮官計畫）"
}
