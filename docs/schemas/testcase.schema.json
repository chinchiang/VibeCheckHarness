{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testcase.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "testcase_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}-[0-9]{2}$"
    },
    "threat_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "abuse_case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ABUSE_CASE_[0-9]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_cluster_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^K-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]+$"
      },
      "minItems": 1,
      "description": "只能是 ROE 目標 ID；主機由 Policy Engine 解析"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^CTL-[0-9]{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reachability",
              "oracle_can_pass",
              "oracle_can_fail"
            ],
            "description": "reachability＝請求確實到達受測端點／程式位置並通過認證（取代 precondition_reached 的依據）；oracle_can_pass＝已知良好的變體讓 oracle 判定通過；oracle_can_fail＝已知違反的變體讓 oracle 判定違反（正對照）"
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "control_id",
          "kind",
          "description",
          "steps",
          "expected"
        ]
      },
      "description": "對照組（B5，H-B1）：至少一個 reachability 對照（E-TC-CONTROLS）。對照必須在有漏洞的版本上也能成立；任何對照沒有 PASS → testresult.outcome 必須是 INVALID"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "STATUS_AND_BODY",
              "STATE_DIFF",
              "TOOL_CHECK",
              "TOOL_CALL_LOG",
              "CANARY",
              "THRESHOLD",
              "DOM_ASSERTION",
              "HUMAN",
              "LLM_GRADER"
            ]
          },
          "description": "此測試使用的 oracle 種類（可多個）。確定性 oracle＝HUMAN 與 LLM_GRADER 以外的全部；只有 HUMAN／LLM_GRADER 判定的違反不算 FAIL 證據（E_inc，docs/05 §4.2）"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "oracle_query_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^Q-[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "count-only DB oracle（docs/03 §7.6 oracle_count）：seed manifest oracle_queries 的 ID"
        },
        "oracle_query_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "查詢本體 hash（G4 綁定）；必須等於 seed manifest 中的 sql_sha256"
        }
      },
      "required": [
        "types",
        "conditions",
        "requirement_refs",
        "oracle_query_id",
        "oracle_query_sha256"
      ]
    },
    "tool_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "BUILTIN_CHECK",
            "GENERATED_SCRIPT",
            "MANUAL"
          ]
        },
        "adapter": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*:[a-z][a-z0-9_]*|manual)$",
          "description": "D13 tool:mode（必須在 tools.yaml 登錄）或 manual；v0.1 的底線寫法（zap_passive 等）已廢止"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "manual_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "adapter",
        "params",
        "manual_reason"
      ]
    },
    "safety_class_proposed": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "safety_class_computed": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "description": "單一 job 的請求上限（含對照組與 canary 紀錄讀取；重播 job 另計）"
        },
        "max_requests_per_trial": {
          "type": "integer",
          "minimum": 1,
          "description": "v0.7（審查 r8，外部 1）：單一 trial（含重播的 trial）的請求上限，Scope Proxy 逐 trial 強制；機率型測試必填。重播預算＝max_requests＋replay_n×max_requests_per_trial；沒有宣告時每次重播以整個 job 計（E-TC-RATE、safety.request_budget）"
        }
      },
      "required": [
        "requests_per_second",
        "max_requests"
      ]
    },
    "request_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^tgt-[a-z0-9-]+$"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "description": "路徑樣板（以 / 開頭、已正規化）；變數段用 {name}。變更請求（POST／PUT／PATCH／DELETE 與 GraphQL mutation）的每個變數段都必須是 {seed:key}（key 在 seed manifest，且路徑是該種子宣告的 path_templates 之一）或 {created:step_id}（同一 job 中較早、打到 seed manifest create_only_endpoints 的建立請求）；否則 S3（E-TC-MUTATION-SCOPE）"
          },
          "step_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "此請求的步驟 ID；{created:step_id} 以它引用這一步建立的物件"
              },
              {
                "type": "null"
              }
            ]
          },
          "graphql_operation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "query",
                  "mutation",
                  "introspection"
                ],
                "description": "GraphQL 請求的操作種類（Scope Proxy 強制）；query／introspection 不算變更請求，但 POST 仍使等級 ≥ S1"
              },
              {
                "type": "null"
              }
            ]
          },
          "graphql_document_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ],
            "description": "v0.6（審查 r7 3.8）：GraphQL 請求的 document（query 文字）的 hash；Scope Proxy 只放行 body 中 document 的 hash 等於它的請求。graphql_operation 不是 null 時必填，而且 GraphQL 只能以 POST 送出（BL-35 完成前；否則 S3）"
          },
          "object_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\{(seed:[a-z0-9_]+|created:[a-z][a-z0-9_]*)\\}$"
            },
            "uniqueItems": true,
            "description": "v0.4（BL-24／BL-25 延伸）：請求在路徑以外（body、query、GraphQL variables、Server Action 參數、PostgREST 過濾條件）指向的物件。路徑沒有變數段的寫入（Server Action、GraphQL mutation、PostgREST），只要這裡至少一項、每一項都是有效的 {seed:key}（種子的 path_templates 含這條路徑）或較早的 {created:step_id}，就在寫入範圍內。Scope Proxy 強制 body 與 query 中的物件 ID 只能是這些值解析後的結果（docs/08 §11.7）。沒有時為空陣列。v0.5：Scope Proxy 的參考規則（safety.request_binding_problem）另外擋下 query 中 eq. 以外的 PostgREST 運算子與 or=／and=、id 鍵下的陣列或物件、複數 id 鍵（ids、*_ids），以及沒有變數段卻沒帶任何綁定 ID 的寫入（整表 PATCH／DELETE）"
          },
          "server_action": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "action_id": {
                    "type": "string",
                    "pattern": "^[0-9A-Za-z_-]{8,128}$",
                    "description": "Next-Action 標頭的值（Server Action ID）"
                  },
                  "args": {
                    "type": "array",
                    "description": "完整的位置參數；字串恰好是 {seed:key}／{created:step_id} 的元素由 Scope Proxy 代換為解析後的值，且必須列在 object_refs"
                  }
                },
                "required": [
                  "action_id",
                  "args"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "v0.5（審查 2026-10-25 H-6）：Next.js Server Action 的位置參數無法以鍵名綁定。宣告後 Scope Proxy 只在 Next-Action 標頭等於 action_id、body 等於代換後的 args 時放行（safety.server_action_problem）；只能用於 POST、沒有變數段的路徑。null＝不是 Server Action"
          }
        },
        "required": [
          "target_id",
          "method",
          "path",
          "step_id",
          "graphql_operation",
          "object_refs",
          "server_action"
        ]
      },
      "minItems": 1,
      "description": "Scope Proxy 以此逐一放行；不在清單中的請求一律阻擋。對照組與 canary 紀錄讀取的請求也必須列入；重播是另開的 job，不計入 rate_limit.max_requests"
    },
    "seed_manifest_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_needed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "db_tables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "oracle 會讀的表；必須 ⊆ ROE db_access.oracle_tables"
        }
      },
      "required": [
        "seed_data",
        "roles",
        "db_tables"
      ]
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "pass_rule": {
          "type": "string"
        },
        "record": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "target_model",
              "target_model_version",
              "temperature",
              "seed"
            ]
          }
        },
        "fail_k_min": {
          "type": "integer",
          "minimum": 1,
          "description": "k ≥ fail_k_min 判 FAIL；預設 1"
        },
        "replay_n": {
          "type": "integer",
          "minimum": 0,
          "description": "FAIL 後重播次數；預設 20"
        },
        "multi_turn_max_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "multi_turn 時的輪數上限（≤ ROE relay.max_turns）"
        },
        "sampling": {
          "anyOf": [
            {
              "enum": [
                "sampled",
                "deterministic"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.7（審查 r8，外部 2）：取樣契約。sampled＝受測功能是取樣的（機率型）；deterministic 只能在沒有任何機率型訊號（LLM 威脅、promptfoo／pyrit、multi_turn、target_model 紀錄）時宣告，否則 E-TC-TRIALS；null＝由受測功能判定（derive.probabilistic_signals）"
        }
      },
      "required": [
        "n",
        "pass_rule",
        "record",
        "fail_k_min",
        "replay_n",
        "multi_turn_max_turns"
      ],
      "description": "機率性測試（LLM 功能）；確定性測試 n＝1。pass_rule 預設「k == 0（k ≥ 1 即 FAIL）」（docs/04 §4.4）"
    },
    "multi_turn": {
      "type": "boolean",
      "description": "多輪 LLM 功能測試；true 時經 Z3→Z1 relay（docs/03 §7.5），ROE relay 必須非 null"
    },
    "script_turns": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "ROE relay.mode＝scripted 時多輪測試的固定使用者輪次（長度 ≤ trials.multi_turn_max_turns ≤ ROE relay.max_turns）；multi_turn false 時為 null"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy_template_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "multi_turn 的攻擊策略範本 hash（G4 綁定）；multi_turn false 時為 null"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_error_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 429,
        "maximum": 599
      },
      "description": "v0.6（審查 r7 4.3）：這個測試預期會引發的錯誤狀態碼（429 或 5xx，validator 另擋 430–499，E-TC-EXPECTED-STATUS；例如注入探測的 500、限流測試的 429），經 G4 核准。這些回應只計入本 job 的預算，不計入 run 層級的 5xx／429 停止條件（safety.counts_for_run_stop）；健康檢查與延遲仍適用於整個 run。沒有就是 []"
    },
    "access_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "resource",
          "action"
        ]
      },
      "description": "v0.5（09 BL-20）：本測試涵蓋的 G1 存取矩陣格子（role × resource × action）；每格必須在 invariants.yaml 的 access_matrix 中（E-TC-ACCESS-CELL）。不針對存取控制的測試為空陣列"
    }
  },
  "required": [
    "testcase_id",
    "threat_id",
    "requirement_ids",
    "abuse_case_id",
    "source_cluster_id",
    "target_ids",
    "preconditions",
    "steps",
    "controls",
    "oracle",
    "tool_binding",
    "safety_class_proposed",
    "safety_class_computed",
    "rate_limit",
    "request_allowlist",
    "seed_manifest_ref",
    "data_needed",
    "trials",
    "multi_turn",
    "script_turns",
    "strategy_template_sha256",
    "artifact_sha256",
    "access_cells"
  ],
  "title": "TestCase（測試案例）",
  "description": "B3 產出（LLM 直接輸出，保持自足以便降級成跨廠商子集）。safety_class_computed 由程式碼依 docs/04 §5 計算，LLM 的 safety_class_proposed 只當下限。工具與模式用 D13 的 tool:mode（tools.yaml）。"
}
