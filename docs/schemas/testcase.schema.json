{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testcase.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "testcase_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}-[0-9]{2}$"
    },
    "threat_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "abuse_case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ABUSE_CASE_[0-9]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_cluster_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^K-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]+$"
      },
      "minItems": 1,
      "description": "只能是 ROE 目標 ID；主機由 Policy Engine 解析"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "STATUS_AND_BODY",
            "STATE_DIFF",
            "TOOL_CHECK",
            "TOOL_CALL_LOG",
            "CANARY",
            "THRESHOLD",
            "DOM_ASSERTION",
            "HUMAN"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "oracle_query_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^Q-[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "count-only DB oracle（docs/03 §7.6 oracle_count）：seed manifest oracle_queries 的 ID"
        },
        "oracle_query_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "查詢本體 hash（G4 綁定）；必須等於 seed manifest 中的 sql_sha256"
        }
      },
      "required": [
        "type",
        "conditions",
        "requirement_refs",
        "oracle_query_id",
        "oracle_query_sha256"
      ]
    },
    "tool_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "BUILTIN_CHECK",
            "GENERATED_SCRIPT",
            "MANUAL"
          ]
        },
        "adapter": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*:[a-z][a-z0-9_]*|manual)$",
          "description": "D13 tool:mode（必須在 tools.yaml 登錄）或 manual；v0.1 的底線寫法（zap_passive 等）已廢止"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "manual_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "adapter",
        "params",
        "manual_reason"
      ]
    },
    "safety_class_proposed": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "safety_class_computed": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "requests_per_second",
        "max_requests"
      ]
    },
    "request_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^tgt-[a-z0-9-]+$"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "description": "路徑樣板（以 / 開頭、已正規化）；變數段用 {name}；DELETE 的每個變數段都必須是 {seed:key}"
          }
        },
        "required": [
          "target_id",
          "method",
          "path"
        ]
      },
      "minItems": 1,
      "description": "Scope Proxy 以此逐一放行；不在清單中的請求一律阻擋"
    },
    "seed_manifest_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_needed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "db_tables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "oracle 會讀的表；必須 ⊆ ROE db_access.oracle_tables"
        }
      },
      "required": [
        "seed_data",
        "roles",
        "db_tables"
      ]
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "pass_rule": {
          "type": "string"
        },
        "record": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "target_model",
              "target_model_version",
              "temperature",
              "seed"
            ]
          }
        },
        "fail_k_min": {
          "type": "integer",
          "minimum": 1,
          "description": "k ≥ fail_k_min 判 FAIL；預設 1"
        },
        "replay_n": {
          "type": "integer",
          "minimum": 0,
          "description": "FAIL 後重播次數；預設 20"
        },
        "multi_turn_max_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "multi_turn 時的輪數上限（≤ ROE relay.max_turns）"
        }
      },
      "required": [
        "n",
        "pass_rule",
        "record",
        "fail_k_min",
        "replay_n",
        "multi_turn_max_turns"
      ],
      "description": "機率性測試（LLM 功能）；確定性測試 n＝1。pass_rule 預設「k == 0（k ≥ 1 即 FAIL）」（docs/04 §4.4）"
    },
    "multi_turn": {
      "type": "boolean",
      "description": "多輪 LLM 功能測試；true 時經 Z3→Z1 relay（docs/03 §7.5），ROE relay 必須非 null"
    },
    "strategy_template_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "multi_turn 的攻擊策略範本 hash（G4 綁定）；multi_turn false 時為 null"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "testcase_id",
    "threat_id",
    "requirement_ids",
    "abuse_case_id",
    "source_cluster_id",
    "target_ids",
    "preconditions",
    "steps",
    "oracle",
    "tool_binding",
    "safety_class_proposed",
    "safety_class_computed",
    "rate_limit",
    "request_allowlist",
    "seed_manifest_ref",
    "data_needed",
    "trials",
    "multi_turn",
    "strategy_template_sha256",
    "artifact_sha256"
  ],
  "title": "TestCase（測試案例）",
  "description": "B3 產出（LLM 直接輸出，保持自足以便降級成跨廠商子集）。safety_class_computed 由程式碼依 docs/04 §5 計算，LLM 的 safety_class_proposed 只當下限。工具與模式用 D13 的 tool:mode（tools.yaml）。"
}
