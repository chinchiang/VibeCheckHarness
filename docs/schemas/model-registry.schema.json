{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-registry.schema.json",
  "title": "Model Registry（models.yaml）",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "litellm": {
        "type": "string",
        "description": "LiteLLM 模型字串。含 <...> 的值是尚未確認的佔位 ID，必須同時標 placeholder: true"
      },
      "placeholder": {
        "type": "boolean",
        "description": "true＝litellm 是尚未確認的佔位模型 ID（例如模型名待確認的 nemotron_cloud）。validator 發出 W-MODEL-PLACEHOLDER，真實 run 前必須換成已確認的 ID；litellm 含 <...> 卻沒有標 placeholder: true → E-MODEL-PLACEHOLDER"
      },
      "api_base": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "family": {
        "type": "string",
        "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
      },
      "lineage": {
        "type": "string"
      },
      "derived_from": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "v0.6（審查 r7 3.9）：本血統衍生自哪個血統（微調、蒸餾或以其權重繼續訓練）；獨立性以血統的根判定，衍生自回報者血統的驗證者不算獨立。省略或 null＝基礎血統"
      },
      "usable_ctx": {
        "type": "integer",
        "minimum": 1
      },
      "structured": {
        "type": "string",
        "enum": [
          "claude_subset",
          "openai_strict",
          "vllm_json_schema",
          "unconfirmed"
        ]
      },
      "data_classes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "P",
            "C"
          ]
        },
        "minItems": 1
      },
      "purpose": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "production",
            "evaluation",
            "prototyping"
          ]
        },
        "minItems": 1
      },
      "fallback": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "api": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "messages",
              "chat_completions",
              "responses"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "store": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "earliest_retirement": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "description": "供應商公告的最早退役日（docs/08 §7；E:providers-49）。日期已過 → 驗證失敗；run 期間會到期 → 警告。未公告寫 null"
      },
      "pricing": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_usd_per_mtok": {
                "type": "number",
                "minimum": 0
              },
              "output_usd_per_mtok": {
                "type": "number",
                "minimum": 0
              },
              "as_of": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "input_usd_per_mtok",
              "output_usd_per_mtok",
              "as_of",
              "source"
            ],
            "description": "價格快照（實作時查證）；null＝未列出，engagement 的 max_cost_usd 仍必填（fail-closed）"
          },
          {
            "type": "null"
          }
        ]
      },
      "hosting": {
        "type": "string",
        "enum": [
          "cloud",
          "self"
        ],
        "description": "第十三輪外部審查（docs/08 §11.12）：cloud＝供應商 API（按 token 計費）；self＝自架（Z4，API 費用 0，只計運算時間）。cloud 且 pricing 為 null 的模型，委任設定必須給 budgets.price_assumptions 的保守上界才可用（E-ENG-PRICING）"
      },
      "rate_limits": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rpm": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tpm": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "rpm",
              "tpm"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "tokenizer": {
        "anyOf": [
          {
            "type": "string",
            "description": "計算 token 的 tokenizer；null＝未知"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "litellm",
      "family",
      "lineage",
      "usable_ctx",
      "structured",
      "data_classes",
      "purpose",
      "fallback",
      "earliest_retirement",
      "hosting"
    ]
  }
}