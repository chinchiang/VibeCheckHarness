{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-registry.schema.json",
  "title": "Model Registry（models.yaml）",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "litellm": {
        "type": "string",
        "description": "LiteLLM 模型字串。含 <...> 的值是尚未確認的佔位 ID，必須同時標 placeholder: true"
      },
      "placeholder": {
        "type": "boolean",
        "description": "true＝litellm 是尚未確認的佔位模型 ID（例如模型名待確認的 nemotron_cloud）。validator 發出 W-MODEL-PLACEHOLDER，真實 run 前必須換成已確認的 ID；litellm 含 <...> 卻沒有標 placeholder: true → E-MODEL-PLACEHOLDER"
      },
      "api_base": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "family": {
        "type": "string",
        "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
      },
      "lineage": {
        "type": "string"
      },
      "usable_ctx": {
        "type": "integer",
        "minimum": 1
      },
      "structured": {
        "type": "string",
        "enum": [
          "claude_subset",
          "openai_strict",
          "vllm_json_schema",
          "unconfirmed"
        ]
      },
      "data_classes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "P",
            "C"
          ]
        },
        "minItems": 1
      },
      "purpose": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "production",
            "evaluation",
            "prototyping"
          ]
        },
        "minItems": 1
      },
      "fallback": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "api": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "messages",
              "chat_completions",
              "responses"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "store": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "earliest_retirement": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "description": "供應商公告的最早退役日（docs/08 §7；E:providers-49）。日期已過 → 驗證失敗；run 期間會到期 → 警告。未公告寫 null"
      }
    },
    "required": [
      "litellm",
      "family",
      "lineage",
      "usable_ctx",
      "structured",
      "data_classes",
      "purpose",
      "fallback",
      "earliest_retirement"
    ]
  }
}