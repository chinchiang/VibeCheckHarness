{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testresult.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "type": "string"
    },
    "testcase_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}-[0-9]{2}$"
    },
    "run_id": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]+$"
      },
      "minItems": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "SKIPPED",
        "STOPPED"
      ]
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "n",
        "k"
      ]
    },
    "replays": {
      "type": "integer",
      "minimum": 0
    },
    "oracle_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "interpreted_by": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "family": {
              "type": "string",
              "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
            }
          },
          "required": [
            "agent_id",
            "family"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "result_id",
    "testcase_id",
    "run_id",
    "executed_at",
    "target_ids",
    "outcome",
    "trials",
    "replays",
    "oracle_observations",
    "request_count",
    "stop_reason",
    "artifact_sha256",
    "interpreted_by"
  ],
  "title": "TestResult（測試結果）",
  "description": "ERROR／SKIPPED／STOPPED 屬於執行失敗，列入「未能測試清單」，不代表需求未滿足。"
}
