{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testresult.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "type": "string"
    },
    "testcase_id": {
      "type": "string",
      "pattern": "^W?TC-[0-9]{3,}-[0-9]{2}$",
      "description": "B4：黑箱 testcase（TC-…）；W4：w4-testcase（WTC-…，v0.5 BL-27，E-W4-TC）"
    },
    "run_id": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "W4",
        "B4"
      ],
      "description": "W4＝白箱可執行測試（Z2）；B4＝黑箱執行（Z3）"
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "B4 job ID（run.jobs 的鍵）；W4 為 null"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]+$"
      },
      "description": "B4 至少一個 ROE 目標；W4 在 Z2 執行，沒有 ROE 目標，為空陣列（v0.5，E-RESULT-TARGETS）"
    },
    "cluster_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{3,}$"
      },
      "description": "此結果作為證據的叢集（也可由 testcase→threat→source_cluster_id 推導；兩者必須一致）"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "SKIPPED",
        "STOPPED",
        "INVALID"
      ],
      "description": "任何對照組沒有 PASS → 必須是 INVALID（E-RESULT-INVALID）；INVALID 不是 PASS 也不是 FAIL，歸為 E_inc"
    },
    "fail_oracles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "STATUS_AND_BODY",
          "STATE_DIFF",
          "TOOL_CHECK",
          "TOOL_CALL_LOG",
          "CANARY",
          "THRESHOLD",
          "DOM_ASSERTION",
          "HUMAN",
          "LLM_GRADER"
        ]
      },
      "description": "回報違反的 oracle 種類；outcome FAIL ⇔ 非空，且必須 ⊆ testcase oracle.types（E-RESULT-ORACLE）"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^CTL-[0-9]{2}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "NOT_RUN"
            ]
          }
        },
        "required": [
          "control_id",
          "outcome"
        ]
      },
      "description": "每個 testcase 對照組的結果，恰好涵蓋 testcase.controls（E-RESULT-CONTROLS）"
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "n_effective": {
          "type": "integer",
          "minimum": 0,
          "description": "v0.4：有效次數 n′＝前置條件（reachability 對照）有到達的次數，≤ n（E-RESULT-TRIALS）。機率型 PASS 需要 k＝0 且 n′ ≥ 30 才是 E_pass（docs/04 §4.4）；v0.3 沒有這個欄位，validator 只能用 n"
        }
      },
      "required": [
        "n",
        "k",
        "n_effective"
      ]
    },
    "replays": {
      "type": "integer",
      "minimum": 0,
      "description": "重播 job 的執行次數 n_r（沒有重播時為 0）"
    },
    "replay_k": {
      "type": "integer",
      "minimum": 0,
      "description": "重播 job 中確定性 oracle 違反的次數 k_r（≤ replays；沒有重播時為 0）。FAIL 的重現判定見 docs/04 §4.4：確定性測試 k_r＝replays，機率型測試 k_r ≥ fail_k_min"
    },
    "oracle_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "precondition_reached": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "boolean"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "evidence_ref"
      ],
      "description": "推導值：所有 reachability 對照都 PASS（E-RESULT-PRECONDITION）；E_pass 的必要條件（docs/05 §4.2）"
    },
    "positive_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "evidence_ref"
      ],
      "description": "推導值：有 oracle_can_fail 對照時＝該對照 PASS；沒有時為 null（E-RESULT-CONTROLS）"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_build_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$",
          "description": "執行時從目標讀到的 build ID（ROE targets[].build_identity）；必須等於 run.repo_commit（完整或 ≥12 字元前綴）；build_identity.method＝none 的目標列在 report-manifest build_unverified_targets（E-RESULT-BUILD）"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_log_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Scope Proxy 請求紀錄的 CAS hash；B4 結果必填（E-RESULT-REQUEST-LOG）"
        },
        {
          "type": "null"
        }
      ]
    },
    "interpreted_by": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "family": {
              "type": "string",
              "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
            }
          },
          "required": [
            "agent_id",
            "family"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Result Analyst（agents.yaml role result_analyst，家族與血統都不在叢集中）；預先登記解讀的確定性結果不需要（null）"
    },
    "interpretation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agrees": {
              "type": "boolean",
              "description": "分析者是否同意 oracle 的解讀；false → E_inc"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "agrees",
            "rationale"
          ],
          "description": "Result Analyst 的 LLM 輸出（interpreted_by 為 null 時也是 null）"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations_source": {
      "anyOf": [
        {
          "enum": [
            "harness",
            "sut"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "v0.7（審查 r8 外部 6）：oracle_observations 的來源。harness＝由 Z2／Z3 的 harness 行程取得（本地 Postgres 的唯讀連線、harness 端的假模型伺服器、受測行程結束後讀取的檔案、Scope Proxy 的請求紀錄）；sut＝由受測程式的行程輸出，可能被受測程式偽造，只能支持 E_inc。W4 結果必填（E-W4-OBSERVATION）；B4 結果的觀察一律來自 harness"
    }
  },
  "required": [
    "result_id",
    "testcase_id",
    "run_id",
    "phase",
    "job_id",
    "executed_at",
    "target_ids",
    "cluster_ids",
    "outcome",
    "fail_oracles",
    "controls",
    "trials",
    "replays",
    "replay_k",
    "oracle_observations",
    "request_count",
    "stop_reason",
    "precondition_reached",
    "positive_control",
    "artifact_sha256",
    "observed_build_id",
    "request_log_sha256",
    "interpreted_by",
    "interpretation",
    "observations_source"
  ],
  "title": "TestResult（測試結果）",
  "description": "ERROR／SKIPPED／STOPPED 屬於執行失敗，INVALID 表示對照組未通過；兩者都列入「未能測試清單」，不代表需求未滿足；它們在 docs/05 §4.2 歸為 E_inc。"
}
