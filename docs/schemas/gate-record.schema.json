{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate_record_id": {
      "type": "string",
      "pattern": "^GR-[0-9A-Za-z-]+$"
    },
    "gate": {
      "type": "string",
      "enum": [
        "G0a",
        "G0b",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "engagement_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "engagement",
            "roe",
            "invariants",
            "disputed_clusters",
            "threat_model",
            "test_plan",
            "s2_job"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "sha256"
      ]
    },
    "initiator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "發起執行或核准 G4 的人（不得是自動化帳號）"
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "test_lead",
              "management",
              "infrastructure_owner",
              "app_owner",
              "security_reviewer"
            ]
          },
          "key_fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "role",
          "key_fingerprint"
        ]
      },
      "minItems": 1,
      "description": "每個關卡要求的角色見 docs/02 §1.3"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject",
              "needs_info"
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item_id",
          "decision",
          "note"
        ]
      },
      "minItems": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_fingerprint": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key_fingerprint",
          "alg",
          "value"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "gate_record_id",
    "gate",
    "engagement_id",
    "run_id",
    "artifact",
    "initiator",
    "approvers",
    "decisions",
    "timestamp",
    "signatures"
  ],
  "description": "Policy Engine 驗證的是本紀錄的簽章（金鑰須在組織的金鑰登錄中）與 artifact.sha256，而不是 checkpoint 內容。G5 的核准者不得是發起者（由驗證程式檢查）。",
  "title": "GateRecord（人工關卡簽章紀錄）"
}
