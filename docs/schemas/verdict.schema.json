{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict_id": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^K-[0-9]{3,}$"
    },
    "cluster_sha256": {
      "$ref": "common.schema.json#/$defs/sha256",
      "description": "v0.7（審查 r9）：本裁決所裁決的叢集的 content hash（validator 推導，E-DERIVED）；叢集又以 member_finding_sha256 釘住成員發現項"
    },
    "readjudicated_by": {
      "type": "string",
      "enum": [
        "W3_adjudicate",
        "G2_apply",
        "W4_readjudicate",
        "B5_readjudicate"
      ]
    },
    "supersedes_verdict_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voter_agent_id": {
            "type": "string"
          },
          "voter_model_key": {
            "type": "string"
          },
          "voter_family": {
            "type": "string",
            "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
          },
          "voter_lineage": {
            "type": "string"
          },
          "stance": {
            "type": "string",
            "enum": [
              "SUPPORT",
              "REFUTE",
              "ABSTAIN"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "cited_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "理由引用的證據（程式位置 file:line、inventory JSON Pointer 或設定檔的 key_path）；不得引用工具結果（驗證者看不到工具輸出，docs/05 §3 規則 5）；沒有可比對證據的票視為棄權"
          },
          "fallback_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "anonymized": {
            "type": "boolean"
          },
          "order_randomized": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean",
            "description": "投票者家族與血統都不在叢集中，且理由引用了通過片段比對的位置或工具證據"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "description": "§4.3 的 w(m, b)；0＝接近零或未校準"
          },
          "weighted_valid": {
            "type": "boolean",
            "description": "valid ∧ weight > 0；只有這些票計入 S"
          }
        },
        "required": [
          "voter_agent_id",
          "voter_model_key",
          "voter_family",
          "voter_lineage",
          "stance",
          "rationale",
          "cited_evidence",
          "fallback_used",
          "anonymized",
          "order_randomized",
          "valid",
          "weight",
          "weighted_valid"
        ]
      }
    },
    "missing_votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "timeout",
              "rate_limited",
              "schema_invalid",
              "provider_error",
              "context_exceeded",
              "policy_denied",
              "budget_exhausted"
            ]
          }
        },
        "required": [
          "agent_id",
          "reason"
        ]
      }
    },
    "tool_corroboration": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "推導值（排序）：強工具佐證＝已解析的 cluster.sarif_refs 中，(adapter, rule_id) 在 calibration.yaml high_precision_rules（同 CWE 桶、precision_lower95 ≥ high_precision_min）的項目（E-VERDICT-TOOLCORR）"
    },
    "tool_signal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "推導值（排序）：弱工具訊號＝其餘已解析的 SARIF ref ∪ E_fail_u 測試結果的 result_ref（E-VERDICT-TOOLSIGNAL）；不能單獨確認，只算獨立來源"
    },
    "independent_sources": {
      "type": "integer",
      "minimum": 0,
      "description": "推導值：len(叢集 independent_families) ＋（有弱 SARIF 訊號 ? 1 : 0）＋（有 E_fail_u ? 1 : 0）；R6 需 ≥ 2（E-VERDICT-SOURCES）"
    },
    "executable_proof": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "testcase_id": {
              "type": "string"
            },
            "result_ref": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trials": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "k": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "n",
                    "k"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "interpretation_confirmed_by": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "agent_id": {
                      "type": "string"
                    },
                    "family": {
                      "type": "string",
                      "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
                    }
                  },
                  "required": [
                    "agent_id",
                    "family"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "testcase_id",
            "result_ref",
            "trials",
            "interpretation_confirmed_by"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "test_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "E_proof",
                "E_fail_u",
                "E_pass",
                "E_inc"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "最強的證據類別；null＝沒有測試結果"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "result_ref": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "class": {
                "type": "string",
                "enum": [
                  "E_proof",
                  "E_fail_u",
                  "E_pass",
                  "E_inc"
                ]
              },
              "positive_control": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "result_ref",
              "class",
              "positive_control",
              "reason"
            ]
          }
        }
      },
      "required": [
        "class",
        "results"
      ]
    },
    "diversity_degraded": {
      "type": "boolean",
      "description": "推導值：非 Lane A、合格驗證家族集合 E 非空，且計權合格票（weighted_valid）的不同家族數 ＜ min(2, |E|)（家族由 agents.yaml／models.yaml 解析；E-VERDICT-DIVERSITY）"
    },
    "no_eligible_verifier": {
      "type": "boolean",
      "description": "推導值：E＝agents.yaml 中 role verifier、且解析出的家族不在叢集 families、血統不在 lineages 的家族集合；|E|＝0 ⇔ true（E-VERDICT-NOELIGIBLE）"
    },
    "calibration_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "w 與 θ 所用的校準版本"
    },
    "theta_confirm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "快照；null＝停用（+∞）"
    },
    "theta_reject": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "快照；null＝停用"
    },
    "provisional": {
      "type": "boolean",
      "description": "推導值：calibration_version 為 null，或本裁決每張票的 weight 都是 0（沒有票也算），或 theta_confirm 為 null（E-VERDICT-PROVISIONAL）"
    },
    "score": {
      "type": "number",
      "description": "S＝Σ w·stance（SUPPORT＝+1、REFUTE＝−1，只計 weighted_valid）"
    },
    "g2_decision_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^GR-[0-9A-Za-z-]+$"
        },
        {
          "type": "null"
        }
      ],
      "description": "G2 逐項決定所在的 GateRecord"
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED_EXECUTABLE",
        "CONFIRMED_CORROBORATED",
        "LIKELY",
        "UNCORROBORATED",
        "DISPUTED",
        "REJECTED"
      ],
      "description": "依 docs/05 §4.2 的有序規則決定；UNVERIFIED 只是發現項層級的狀態，不是裁決"
    },
    "status_cap": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "LIKELY",
            "UNCORROBORATED"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "LIKELY：R8；UNCORROBORATED：Lane A（R9）"
    },
    "advisory": {
      "type": "boolean",
      "description": "Lane A 的參考性結果（D8）"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "test_not_reproduced",
              "test_inconclusive",
              "conflicting_test_results",
              "g3_rejected",
              "post_g2_conflict",
              "w4_became_disputed"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "g3_rejected 必填"
          }
        },
        "required": [
          "kind",
          "reason"
        ]
      }
    },
    "decided_by": {
      "const": "aggregator"
    },
    "rule_version": {
      "type": "string",
      "description": "docs/05 規則版本；必須等於 run.rule_version 與 vchlib.adjudicate.RULE_VERSION（目前 05-v0.7）"
    },
    "rule_trace": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R([0-9]|1[0-3])(:.*)?$"
      },
      "minItems": 1,
      "description": "依序觸發的規則（R0–R13），可附說明，例如 \"R7 row 10\""
    }
  },
  "required": [
    "verdict_id",
    "cluster_id",
    "cluster_sha256",
    "readjudicated_by",
    "supersedes_verdict_id",
    "votes",
    "missing_votes",
    "tool_corroboration",
    "tool_signal",
    "independent_sources",
    "executable_proof",
    "test_evidence",
    "diversity_degraded",
    "no_eligible_verifier",
    "calibration_version",
    "theta_confirm",
    "theta_reject",
    "provisional",
    "score",
    "g2_decision_ref",
    "status",
    "status_cap",
    "advisory",
    "annotations",
    "decided_by",
    "rule_version",
    "rule_trace"
  ],
  "title": "Verdict（裁決）",
  "description": "Aggregator 依 docs/05 §4.2 有序規則（R0–R13）與 §4.3 校準權重決定。每一版裁決都保留（append-only）：重新裁決產生新的 verdict_id，以 supersedes_verdict_id 指向前一版。"
}
