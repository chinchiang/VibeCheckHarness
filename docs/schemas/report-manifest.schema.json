{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-manifest.schema.json",
  "title": "Report Manifest（報告清單）",
  "description": "B6／W 報告的產物清單：每個產物的 hash、裁決統計與未能測試清單。gaps 必須與 run 紀錄的 gaps 一致；Lane A 報告必須標示僅供參考。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^RPT-[0-9A-Za-z-]+$"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "advisory": {
      "type": "boolean",
      "description": "Lane A＝true（D8）"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "whitebox_report",
              "sarif",
              "threat_model",
              "test_plan",
              "testresult",
              "verdict",
              "gate_record",
              "audit_log",
              "followup_draft"
            ]
          },
          "ref": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "kind",
          "ref",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "verdict_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CONFIRMED_EXECUTABLE": {
          "type": "integer",
          "minimum": 0
        },
        "CONFIRMED_CORROBORATED": {
          "type": "integer",
          "minimum": 0
        },
        "LIKELY": {
          "type": "integer",
          "minimum": 0
        },
        "UNCORROBORATED": {
          "type": "integer",
          "minimum": 0
        },
        "DISPUTED": {
          "type": "integer",
          "minimum": 0
        },
        "REJECTED": {
          "type": "integer",
          "minimum": 0
        },
        "FIXED": {
          "type": "integer",
          "minimum": 0,
          "description": "審查 r11（05-v0.11）：regression run 中回歸測試通過的已確認叢集"
        }
      },
      "required": [
        "CONFIRMED_EXECUTABLE",
        "CONFIRMED_CORROBORATED",
        "LIKELY",
        "UNCORROBORATED",
        "DISPUTED",
        "REJECTED",
        "FIXED"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref",
          "reason"
        ]
      },
      "description": "未能測試清單（run.gaps）"
    },
    "manual_review_clusters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations_ref": {
      "type": "string",
      "description": "報告附的限制聲明（docs/06 §3）"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "由本 run 的測試結果重算（E-REPORT-METRICS）：control_pass_rate＝PASS 的對照結果數／全部對照結果數（四捨五入到 4 位；沒有對照為 null）",
      "properties": {
        "results_total": {
          "type": "integer",
          "minimum": 0
        },
        "results_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "control_pass_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_access_matrix_coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.5（BL-20；審查 r7 改名）：G1 存取矩陣中有測試案例的格子（本 run 的 testcase 與 w4-testcase 的 access_cells）÷ 總格數（每列的 actions 各算一格）；沒有矩陣為 null。這是計畫，不代表已執行"
        },
        "executed_access_matrix_coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.5（審查 r7，外部審查 5）：同上，但只算至少有一個有效執行結果的測試案例：outcome 為 PASS 或 FAIL、對照全部 PASS、有已錨定且 hash 相符的 sandbox_job_end；報告正文必須與 planned 並列"
        },
        "endpoint_slice_coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.5（BL-20）：handler 檔案出現在本 run 切片中的 inventory endpoints ÷ 總數；沒有 endpoints 為 null"
        },
        "planned_endpoint_test_coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.5（BL-20；審查 r7 改名）：被本 run 的黑箱 testcase request_allowlist 打到的 inventory endpoints（方法相同、路徑樣板相同）÷ 總數；沒有 endpoints 為 null。這是計畫，不代表已執行"
        },
        "executed_endpoint_test_coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "v0.5（審查 r7，外部審查 5）：同上，但只算有有效執行結果的黑箱 testcase（定義同 executed_access_matrix_coverage）"
        }
      },
      "required": [
        "results_total",
        "results_invalid",
        "control_pass_rate",
        "planned_access_matrix_coverage",
        "executed_access_matrix_coverage",
        "endpoint_slice_coverage",
        "planned_endpoint_test_coverage",
        "executed_endpoint_test_coverage"
      ]
    },
    "build_unverified_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/target_id"
      },
      "description": "有測試結果、但 ROE build_identity.method＝none 的目標（無法確認測到的 build＝run.repo_commit；E-RESULT-BUILD）；environment＝tester_controlled 的目標（例如 canary）不是受測系統，不列入"
    },
    "absent_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "description": "baseline run 有、本 run 沒有的叢集指紋（SARIF baselineState absent）；沒有 baseline_run_id 時為 []（E-CLUSTER-BASELINE）"
    },
    "over_cap_items": {
      "type": "array",
      "description": "v0.4（BL-26）：超出關卡佇列上限、沒有逐項人審的項目。G2：叢集 ID，該 run 的 G2 紀錄必須恰好有 g2_max_items 項決定且不含它；G3：種子威脅 ID（seed_id），v0.5 起其 threat_id 在 G3 紀錄中的決定是 over_cap（Gate Service 寫入、依規則視同駁回，D5 與 R13 都看得到；E-REPORT-QUEUE）。都列入 ASI09 抽查母體",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "enum": [
              "G2",
              "G3"
            ]
          },
          "item_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "gate",
          "item_id"
        ]
      }
    },
    "report_only_clusters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "v0.4（BL-26，docs/02 W5 剪枝）：只列報告、不轉成種子威脅的叢集。每項的最新裁決必須是 UNCORROBORATED，且沒有任何種子威脅以它為 source_cluster_id（E-REPORT-QUEUE）；rubric 嚴重度與高風險條件由工具包計算，validator 不重算"
    },
    "evidential": {
      "type": "string",
      "enum": [
        "separated",
        "self_attested"
      ],
      "description": "審查 r11：證據價值。separated＝職責分離的委任（team／full）；self_attested＝Lite，一人持有所有金鑰與主機，簽章、錨點與收件時間只供自查，不可作為對外證據（docs/06 §3 #26；E-REPORT 依 assurance_profile 推導）"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "generated_at",
    "advisory",
    "artifacts",
    "verdict_counts",
    "gaps",
    "manual_review_clusters",
    "limitations_ref",
    "metrics",
    "build_unverified_targets",
    "absent_fingerprints",
    "over_cap_items",
    "report_only_clusters",
    "evidential"
  ]
}
