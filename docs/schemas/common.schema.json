{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"common.schema.json","title":"共用定義（v0.2）","description":"非 LLM 輸出的 schema 共用的定義。LLM 直接輸出的 schema（finding、threat、testcase、commander-plan）保持自足，不引用本檔，才能降級成跨廠商子集（docs/03 §8.3）。",
"$defs":{
"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","description":"content-addressed 產物參照：sha256:<hex>"},
"sha256_or_null":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
"datetime":{"type":"string","format":"date-time","description":"RFC 3339，必須帶時區位移"},
"datetime_or_null":{"anyOf":[{"$ref":"#/$defs/datetime"},{"type":"null"}]},
"date":{"type":"string","format":"date"},
"person_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$","description":"金鑰登錄中的 person_id（人或服務身分）"},
"role":{"type":"string","enum":["test_lead","management","infrastructure_owner","app_owner","security_reviewer","legal_reviewer","z3_executor"],"description":"金鑰登錄的角色；z3_executor 是 Executor 的服務金鑰（docs/03 §6.1）"},
"fingerprint":{"type":"string","pattern":"^ed25519:SHA256:[A-Za-z0-9+/]{43}$","description":"[H] ed25519:SHA256: + sha256(32 位元組原始公鑰) 的無填補 base64；與 OpenSSH 指紋格式相似但不相容"},
"person_ref":{"type":"object","additionalProperties":false,"properties":{"person_id":{"$ref":"#/$defs/person_id"},"role":{"$ref":"#/$defs/role"},"key_fingerprint":{"$ref":"#/$defs/fingerprint"}},"required":["person_id","role","key_fingerprint"],"description":"簽署人或核准者；必須對應金鑰登錄中的一筆 entry（登錄是唯一信任來源，D11）"},
"signature":{"type":"object","additionalProperties":false,"properties":{"signer":{"$ref":"#/$defs/person_id"},"key_fingerprint":{"$ref":"#/$defs/fingerprint"},"alg":{"const":"ed25519"},"value":{"type":"string","pattern":"^[A-Za-z0-9+/]{86}==$","description":"64 位元組 Ed25519 簽章的 base64"}},"required":["signer","key_fingerprint","alg","value"],"description":"分離式簽章：對「移除 signatures 後的文件」做 RFC 8785 JCS 正規化，再以 Ed25519 簽署（D11）"},
"signatures":{"type":"array","items":{"$ref":"#/$defs/signature"}},
"data_class":{"type":"string","enum":["P","C"]},
"run_id":{"type":"string","pattern":"^run-[0-9a-z-]+$"},
"engagement_id":{"type":"string","pattern":"^eng-[a-z0-9-]+$"},
"target_id":{"type":"string","pattern":"^tgt-[a-z0-9-]+$"},
"tool_id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$","description":"D13 工具 ID"},
"tool_mode":{"type":"string","pattern":"^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$","description":"D13 tool:mode"},
"gate":{"type":"string","enum":["G0a","G0b","G1","G2","G3","G4","G5","GB"]},
"gate_outcome":{"type":"string","enum":["APPROVED","PARTIALLY_APPROVED","REJECTED","NEEDS_INFO","EXPIRED","VERIFIED","VERIFY_FAILED"],"description":"VERIFIED／VERIFY_FAILED 只用於 G0a／G0b 離線驗章；PARTIALLY_APPROVED 只用於 G3／G4"},
"cwe_bucket":{"type":"string","enum":["injection","authz","authn","crypto","secrets","config","deserialization","ssrf","path_traversal","llm_specific","other"]},
"hhmm":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},
"window":{"type":"object","additionalProperties":false,"properties":{"days":{"type":"array","items":{"enum":["mon","tue","wed","thu","fri","sat","sun"]},"minItems":1},"start":{"$ref":"#/$defs/hhmm"},"end":{"$ref":"#/$defs/hhmm"},"tz":{"type":"string","description":"IANA 時區；Windows 需安裝 tzdata"}},"required":["days","start","end","tz"],"description":"[start, end)；end ≤ start 表示跨午夜，屬於 start 所在的那一天（例如 fri 22:00–02:00 延伸到週六凌晨）"},
"budget_caps":{"type":"object","additionalProperties":false,"properties":{"max_input_tokens":{"type":"integer","minimum":0},"max_output_tokens":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"max_cost_usd":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}],"description":"null＝未設定 → Gateway 拒絕（fail-closed）"},"max_compute_minutes":{"type":"integer","minimum":0}},"required":["max_input_tokens","max_output_tokens","max_cost_usd","max_compute_minutes"]}
}}
