  "preconditions": [
    "種子資料：合成租戶 A、B 各一張發票",
    "角色 tenantA_user、tenantB_user 的 storageState 由 Session Provider 提供"
  ],
  "steps": [
    "以 tenantA_user GET /api/invoices（發票列表）",
    "檢查列表中沒有 tenant_b_invoice 的 id"
  ],
  "controls": [
    {
      "control_id": "CTL-01",
      "kind": "reachability",
      "description": "tenantA_user 讀發票列表：認證有效、請求到達列表端點",
      "steps": [
        "以 tenantA_user GET /api/invoices"
      ],
      "expected": "200，且列表含 tenant_a_invoice 的 id"
    },
    {
      "control_id": "CTL-02",
      "kind": "oracle_can_fail",
      "description": "正對照：tenantB_user 讀發票列表；oracle 的「列表含 tenant_b_invoice 的 id」條件必須判定命中",
      "steps": [
        "以 tenantB_user GET /api/invoices",
        "對回應套用 oracle 條件"
      ],
      "expected": "200，且 oracle 判定列表含 tenant_b_invoice 的 id"
    }
  ],
  "oracle": {
    "types": [
      "STATUS_AND_BODY"
    ],
    "conditions": [
      "status 200",
      "tenantA_user 的列表回應不含 tenant_b_invoice 的 id（inv-b-0001）"
    ],
