    "tgt-staging-api"
  ],
  "preconditions": [
    "種子資料：合成租戶 A、B 各一張發票",
    "角色 tenantA_user、tenantB_user 的 storageState 由 Session Provider 提供"
  ],
  "steps": [
    "以 tenantA_user 對 B 的發票送 GET",
    "以 tenantA_user 對 B 的發票送 PUT（種子資料）",
    "以 tenantA_user 對 B 的發票送 DELETE（僅種子 id）"
  ],
  "oracle": {
    "type": "STATE_DIFF",
    "conditions": [
      "status in {403, 404}",
      "response body 不含 B 的發票欄位",
      "Q-invoice-b-row 前後計數相同（B 的發票資料列未被改動）"
    ],
    "requirement_refs": [
      "REQ-ASVS-8.2.2",
      "INV-AC-007"
    ],
    "oracle_query_id": "Q-invoice-b-row",
    "oracle_query_sha256": "sha256:8c2e4a6b0d1f3e5a7c9b2d4f6e8a0c1b3d5f7e9a2c4b6d8f0e1a3c5b7d9f2e4a"
  },
  "tool_binding": {
    "kind": "GENERATED_SCRIPT",
    "adapter": "playwright:api",
    "params": {
      "contexts": [
        "tenantA_user",
        "tenantB_user"
      ]
    },
    "manual_reason": null
  },
  "safety_class_proposed": "S1",
  "safety_class_computed": "S1",
  "rate_limit": {
    "requests_per_second": 2,
    "max_requests": 30
  },
  "request_allowlist": [
    {
      "target_id": "tgt-staging-api",
      "method": "GET",
      "path": "/api/invoices/{seed:tenant_b_invoice}"
    },
    {
      "target_id": "tgt-staging-api",
      "method": "PUT",
      "path": "/api/invoices/{seed:tenant_b_invoice}"
    },
    {
      "target_id": "tgt-staging-api",
      "method": "DELETE",
      "path": "/api/invoices/{seed:tenant_b_invoice}"
    }
  ],
  "seed_manifest_ref": "docs/examples/seed-manifest.yaml",
  "data_needed": {
    "seed_data": [
      "tenant_a_invoice",
      "tenant_b_invoice"
    ],
    "roles": [
      "tenantA_user",
      "tenantB_user"
    ],
    "db_tables": [
      "invoices"
    ]
  },
  "trials": {
