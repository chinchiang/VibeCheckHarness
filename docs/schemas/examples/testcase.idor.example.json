{
  "testcase_id": "TC-012-01",
  "threat_id": "T-012",
  "requirement_ids": [
    "REQ-ASVS-8.2.2",
    "INV-AC-007"
  ],
  "abuse_case_id": "ABUSE_CASE_012",
  "source_cluster_id": "K-005",
  "target_ids": [
    "tgt-staging-api"
  ],
  "preconditions": [
    "種子資料：合成租戶 A、B 各一張發票",
    "角色 tenantA_user、tenantB_user 的 storageState 由 Session Provider 提供"
  ],
  "steps": [
    "以 tenantA_user 對 B 的發票送 GET",
    "以 tenantA_user 對 B 的發票送 PUT（修改一個非關鍵欄位為合成值；種子資料）",
    "以 tenantA_user 對 B 的發票送 DELETE（僅種子 id）"
  ],
  "controls": [
    {
      "control_id": "CTL-01",
      "kind": "reachability",
      "description": "tenantA_user 讀自己的發票：證明認證有效、請求到達端點",
      "steps": [
        "以 tenantA_user GET /api/invoices/{seed:tenant_a_invoice}"
      ],
      "expected": "200，且 body 含 tenant_a_invoice 的欄位"
    },
    {
      "control_id": "CTL-02",
      "kind": "oracle_can_fail",
      "description": "正對照：tenantB_user 讀自己的發票 B；把 oracle 的 FAIL 條件（status 2xx 且 body 含 B 的發票欄位）套在這個合法回應上必須判定命中，證明 oracle 看得到 B 的欄位、也認得成功的狀態碼（v0.5：涵蓋狀態碼子 oracle）",
      "steps": [
        "以 tenantB_user GET /api/invoices/{seed:tenant_b_invoice}",
        "對回應套用 oracle 的 FAIL 條件（狀態碼與 body 兩個子 oracle）"
      ],
      "expected": "200，且 oracle 的 FAIL 條件判定為命中（status 2xx 且含 B 的發票欄位）"
    }
  ],
  "oracle": {
    "types": [
      "STATUS_AND_BODY",
      "STATE_DIFF"
    ],
    "conditions": [
      "PASS：status in {403, 404}，且 body 不含 B 的發票欄位，且 Q-invoice-b-row 前後的列 hash 相同",
      "FAIL：status 為 2xx 且 body 含 B 的發票欄位，或 Q-invoice-b-row 的列 hash 改變（B 的發票資料列被改動，包括 PUT 就地修改；v0.4 由計數改為 row_hash）",
      "其他（405、422、5xx 等非 2xx 且非 403／404，或 status 與 body 互相矛盾）：INCONCLUSIVE，不算 FAIL（v0.5，審查 2026-10-25 M-2）"
    ],
    "requirement_refs": [
      "REQ-ASVS-8.2.2",
      "INV-AC-007"
    ],
    "oracle_query_id": "Q-invoice-b-row",
    "oracle_query_sha256": "sha256:8c2e4a6b0d1f3e5a7c9b2d4f6e8a0c1b3d5f7e9a2c4b6d8f0e1a3c5b7d9f2e4a"
  },
  "tool_binding": {
    "kind": "GENERATED_SCRIPT",
    "adapter": "playwright:api",
    "params": {
