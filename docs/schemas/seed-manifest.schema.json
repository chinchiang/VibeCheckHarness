{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"seed-manifest.schema.json","title":"Seed Manifest（種子資料清單）","description":"docs/03 §7.6、docs/04 §5：合成種子資料的 ID、所在表與重置方式。DELETE 路徑樣板的每個變數段都必須是 {seed:key}，key 在此清單中。重置失敗 → 之後使用此清單的 job 一律 SKIPPED（seed_reset_failed）。","type":"object","additionalProperties":false,
"properties":{
"manifest_ref":{"type":"string","description":"ROE db_access.seed_manifest_ref 與 testcase seed_manifest_ref 引用的名稱"},
"engagement_id":{"$ref":"common.schema.json#/$defs/engagement_id"},
"db_target_id":{"$ref":"common.schema.json#/$defs/target_id","description":"kind: database 的 ROE 目標"},
"reset":{"type":"object","additionalProperties":false,"properties":{"method":{"enum":["snapshot_restore","seed_script"]},"script_sha256":{"$ref":"common.schema.json#/$defs/sha256_or_null"},"verify_query_id":{"type":"string","description":"重置後以 oracle 唯讀憑證計數驗證"}},"required":["method","script_sha256","verify_query_id"]},
"seeds":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[a-z0-9_]+$"},"additionalProperties":{"type":"object","additionalProperties":false,"properties":{"table":{"type":"string"},"id":{"type":"string"},"owner_role":{"type":"string","description":"擁有此物件的測試角色或合成使用者（例如 U2 只存在於種子資料）"},"description":{"type":"string"}},"required":["table","id","owner_role","description"]}},
"oracle_queries":{"type":"object","propertyNames":{"pattern":"^Q-[A-Za-z0-9_-]+$"},"additionalProperties":{"type":"object","additionalProperties":false,"properties":{"table":{"type":"string"},"sql_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"params":{"type":"array","items":{"type":"string","pattern":"^(seed:[a-z0-9_]+|const:[A-Za-z0-9_.-]+)$"},"description":"只能是種子 ID 或宣告的常數（docs/03 §7.6 oracle_count）"},"returns":{"const":"count"}},"required":["table","sql_sha256","params","returns"]},"description":"count-only oracle 查詢；testcase 以 oracle_query_id＋oracle_query_sha256 引用（G4 綁定）"}},
"required":["manifest_ref","engagement_id","db_target_id","reset","seeds","oracle_queries"]}
