                    "properties": {
                      "model_key": {
                        "type": "string"
                      },
                      "reproduced": {
                        "type": "boolean"
                      },
                      "checked_at": {
                        "$ref": "common.schema.json#/$defs/datetime"
                      }
                    },
                    "required": [
                      "model_key",
                      "reproduced",
                      "checked_at"
                    ]
                  }
                },
                "variant_recall_gap": {
                  "type": "array",
