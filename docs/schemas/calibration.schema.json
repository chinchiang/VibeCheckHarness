  },
  "required": [
    "calibration_id",
    "calibration_version",
    "config",
    "result"
  ],
  "$defs": {
    "split_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ci_low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ci_high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "tp": {
          "type": "integer",
          "minimum": 0,
          "description": "審查 r11：該切分中被該分支確認（或駁回）的叢集裡的真缺陷數；validator 以 tp／n 重算 precision 與 Wilson 95% 界限（E-CAL-THETA）"
        },
        "n_apps": {
          "type": "integer",
          "minimum": 0,
          "description": "第十三輪外部審查（05-v0.14）：這 n 個叢集來自幾個不同的應用；validator 以設計效果 n_eff＝n／(1＋(n／n_apps − 1)·icc) 重算 Wilson 界限，可行的門檻另需 n_apps ≥ clustering.min_apps（docs/05 §5.7）"
        }
      },
      "required": [
        "precision",
        "recall",
        "ci_low",
        "ci_high",
        "n",
        "tp",
        "n_apps"
      ],
      "description": "審查 r11（外部審查）：機率欄位限制在 0..1；validator 另以 tp／n 重算（E-CAL-THETA）；第十三輪外部審查（05-v0.14）：n_apps 記不同應用數，界限以 n_eff 計算"
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null＝停用（+∞）"
        },
        "feasible": {
          "type": "boolean"
        },
        "calibration": {
          "$ref": "#/$defs/split_stats"
        },
        "holdout": {
          "$ref": "#/$defs/split_stats"
        },
        "generalised": {
          "type": "boolean"
        },
        "by_bucket": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/cwe_bucket"
          },
          "additionalProperties": {
            "$ref": "#/$defs/threshold"
          },
          "description": "v0.6（審查 r7 3.5）：theta_confirm／theta_reject 依 CWE 桶分開搜尋，規則只用叢集所屬桶的門檻；沒有列出的桶視為停用（+∞），generalised 為 false 的門檻也停用。外層的值是合併統計，只供報告（E-CAL-THETA）；high_precision_min 是政策值，沒有 by_bucket"
        }
      },
      "required": [
        "value",
        "feasible",
        "calibration",
        "holdout",
        "generalised"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "exit_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null＝次要分析，沒有退出條件（M-11）"
        },
        "by_model": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_key": {
                "type": "string"
              },
              "cwe_bucket": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/cwe_bucket"
                  },
                  {
                    "const": "pooled"
                  }
                ]
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ci_low": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ci_high": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "ci_method": {
                "const": "wilson"
              },
              "flag": {
                "anyOf": [
                  {
                    "const": "support_leaning"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "真陰性率 < 0.5 → 報告標示「傾向支持」"
              }
            },
            "required": [
              "model_key",
              "cwe_bucket",
              "value",
              "ci_low",
              "ci_high",
              "n",
              "ci_method",
              "flag"
            ]
          }
        }
      },
      "required": [
        "value",
        "ci_low",
        "ci_high",
        "n",
        "exit_pass"
      ]
    }
  }
}
