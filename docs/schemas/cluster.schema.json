{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cluster.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cluster_id": {
      "type": "string",
      "pattern": "^K-[0-9]{3,}$"
    },
    "run_id": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "white_box",
        "black_box",
        "tool_only"
      ],
      "description": "white_box＝由 W2 發現項叢集化；black_box＝B5 由沒有 source_cluster_id 的威脅之測試結果建立（成員可為空，E-CLUSTER-ORIGIN）；tool_only＝v0.5（BL-13）W3 只由 W1 工具結果建立（沒有 LLM 成員；tool_report_refs 至少一筆且能解析，位置取自這些工具結果）"
    },
    "threat_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^T-[0-9]{3,}$",
          "description": "black_box 必填：來源威脅（其 source_cluster_id 為 null）；white_box 為 null"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string",
              "description": "sink 所在函式或 AST 節點的完整限定名"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              },
              "required": [
                "file",
                "line"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sink": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              },
              "required": [
                "file",
                "line"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target_id": {
                  "type": "string",
                  "pattern": "^tgt-[a-z0-9-]+$"
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "HEAD",
                    "OPTIONS",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path_template": {
                  "type": "string"
                }
              },
              "required": [
                "target_id",
                "method",
                "path_template"
              ],
              "description": "black_box 叢集的正規位置（端點）；white_box 可省略"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "file",
        "symbol",
        "source",
        "sink"
      ],
      "description": "white_box：file、symbol、sink 必填；black_box：endpoint 必填，file／symbol／sink 可為 null（E-CLUSTER-ORIGIN）"
    },
    "cwe_bucket": {
      "type": "string",
      "enum": [
        "injection",
        "authz",
        "authn",
        "crypto",
        "secrets",
        "config",
        "deserialization",
        "ssrf",
        "path_traversal",
        "llm_specific",
        "other"
      ]
    },
    "cwes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      },
      "minItems": 1
    },
    "member_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{3,}$"
      },
      "description": "white_box 至少一個；black_box 可為空（E-CLUSTER-ORIGIN）"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
      }
    },
    "lineages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "成員發現項的模型血統"
    },
    "independent_families": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "模型家族（廠商或主要訓練者），例如 anthropic、openai、nvidia"
      },
      "description": "推導值：第一輪（reporter.round＝1）由 reviewer 角色回報的成員家族（Lane A 與 CMD-2 加派不計入；E-CLUSTER-FAMILIES）"
    },
    "sarif_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "同位置、同 bucket 的 SARIF 結果 CAS 參照；每個都必須出現在同一 run 稽核日誌中成功（payload.ok true）的白箱工具（tools.yaml zone Z2、b4_executable false）tool_invocation_end 事件的 payload_refs（E-SARIF-REF）"
    },
    "tool_report_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true,
      "description": "v0.5（BL-13）：引發 tool_only 叢集的 W1 工具結果（SARIF ref，解析規則同 sarif_refs，E-SARIF-REF）。它們是「回報」不是佐證：不計入 tool_corroboration、tool_signal、independent_sources；sarif_refs 只能放其他工具在同一位置的結果。非 tool_only 叢集為空陣列"
    },
    "linked_cluster_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "跨 run 穩定指紋：white_box＝sha256(JCS({cwe_bucket, file, symbol}))；black_box＝sha256(JCS({cwe_bucket, target_id, method, path_template}))；不含行號（E-CLUSTER-FINGERPRINT）"
    },
    "baseline_state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "new",
            "unchanged",
            "updated",
            "absent"
          ],
          "description": "SARIF 2.1.0 baselineState 語意；null＝本 run 沒有 baseline_run_id。new＝指紋不在基準 run；unchanged＝同指紋且成員證據 hash 相同；updated＝同指紋、證據改變；absent 只用於報告的 absent_fingerprints（E-CLUSTER-BASELINE）"
        },
        {
          "type": "null"
        }
      ]
    },
    "reopened": {
      "type": "boolean",
      "description": "資訊性：本 run 為 new，但在更早的 run 曾是 absent"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "description": "v0.7（審查 r8 F5）：rubric 嚴重度（docs/08 §11.17），由 validator 依 inventory、合併 DFD 與 G1 資料分級推導（E-CLUSTER-SEVERITY）；G2 路由與 report_only 用它，成員自報的 finding.severity 只供參考"
    },
    "carried_from": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "$ref": "common.schema.json#/$defs/run_id"
            },
            "cluster_id": {
              "type": "string"
            },
            "fingerprint": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "run_id",
            "cluster_id",
            "fingerprint"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "v0.7（審查 r8 外部 5）：regression／followup run 帶入的叢集是本 run 的新實例（自己的 cluster_id、run_id 是本 run），以 carried_from 指回來源：parent run 的叢集，fingerprint 必須相同（E-CLUSTER-CARRY）。跨 run 的問題識別用 fingerprint，不共用 ID"
    }
  },
  "required": [
    "cluster_id",
    "run_id",
    "origin",
    "threat_id",
    "canonical_location",
    "cwe_bucket",
    "cwes",
    "member_finding_ids",
    "families",
    "lineages",
    "independent_families",
    "sarif_refs",
    "tool_report_refs",
    "linked_cluster_ids",
    "fingerprint",
    "baseline_state",
    "reopened",
    "severity",
    "carried_from"
  ],
  "title": "Cluster（叢集）"
}
