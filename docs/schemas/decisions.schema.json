{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions.schema.json",
  "title": "Gate decisions（vibecheck gate approve --decisions decisions.yaml）",
  "description": "第十四輪內部審查（C6）：核准者交給 `vibecheck gate approve` 的逐項決定檔。CLI 以它產生 GateRecord（decisions[] 一一對應，item_sha256 由程式從被核准的條目內容重算）並由核准者簽署；它本身不簽章、不保存，GateRecord 才是紀錄。G1 另可帶核准者改寫後的條目（edited_item，寫回 invariants.yaml 再算 hash）與問卷答案（answers[]，docs/08 §11.4 的 12 題）。[H]",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "GB"
      ]
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1,
      "description": "vibecheck gate list 列出的待決關卡 ID"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accept",
              "reject",
              "needs_info"
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "reject／needs_info 必填（CLI 強制）"
          },
          "risk_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "同 gate-record decisions[].risk_override"
          },
          "carried_from": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "run_id": {
                    "$ref": "common.schema.json#/$defs/run_id"
                  },
                  "gate_record_id": {
                    "type": "string"
                  },
                  "item_sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  }
                },
                "required": [
                  "run_id",
                  "gate_record_id",
                  "item_sha256"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "只有 G1／G3 的 accept 能沿用（E-GATE-CARRY）"
          },
          "edited_item": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ],
            "description": "G1 限定：核准者改寫後的條目內容（invariants.yaml 該條目的完整物件）；CLI 寫回 invariants.yaml，item_sha256 以改寫後的內容計算"
          }
        },
        "required": [
          "item_id",
          "decision",
          "note",
          "risk_override",
          "carried_from",
          "edited_item"
        ]
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null＝「不知道」；第 1–3 題為 null 時 G1 只能 NEEDS_INFO"
          },
          "proposed_by_model": {
            "type": "boolean",
            "description": "true＝採用 Invariant Drafter 的提議，未修改"
          }
        },
        "required": [
          "question_id",
          "answer",
          "proposed_by_model"
        ]
      },
      "description": "G1 限定（docs/08 §11.4 的問卷）；其他關卡為空陣列"
    }
  },
  "required": [
    "gate",
    "run_id",
    "gate_id",
    "decisions",
    "answers"
  ]
}
