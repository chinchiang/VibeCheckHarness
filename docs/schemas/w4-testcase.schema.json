{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w4-testcase.schema.json",
  "title": "W4 TestCase（白箱可執行測試案例）",
  "description": "v0.5（09 BL-27，docs/02 W4）：W4 在 Z2 執行的白箱測試（單元測試、性質測試、拋棄式本地 Postgres 的 RLS 測試、腳本式假模型的工具防護測試）。與黑箱的 testcase.schema.json 分開：沒有 ROE 目標、威脅、請求白名單或安全等級；oracle 只能引用 G1 已核准的條目（E-TC-REQ-UNAPPROVED）。phase W4 的 testresult 以 testcase_id 指向這裡（E-W4-TC）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "testcase_id": {
      "type": "string",
      "pattern": "^WTC-[0-9]{3}-[0-9]{2}$",
      "description": "WTC-<叢集編號>-<序號>"
    },
    "run_id": {
      "type": "string"
    },
    "cluster_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{3,}$"
      },
      "description": "要化解的叢集：同一個 run 的 white_box 或 tool_only 叢集（E-W4-TC）"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "oracle 依據的 G1 條目；全部必須經 G1 核准（E-TC-REQ-UNAPPROVED）"
    },
    "kind": {
      "type": "string",
      "enum": [
        "unit",
        "property",
        "local_rls",
        "fake_model"
      ],
      "description": "unit／property＝單元或性質測試（Hypothesis、fast-check）；local_rls＝拋棄式本地 Postgres 套用 repo migration 與合成種子；fake_model＝以腳本式假模型取代上游 LLM，測程式的工具防護"
    },
    "language": {
      "type": "string",
      "enum": [
        "python",
        "typescript",
        "javascript",
        "sql"
      ]
    },
    "framework": {
      "type": "string",
      "minLength": 1,
      "description": "例如 pytest＋hypothesis、vitest＋fast-check、pytest＋psycopg"
    },
    "test_file": {
      "type": "string",
      "minLength": 1,
      "description": "測試檔在 CAS 工作區中的路徑（不寫回受測 repo）"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": {
          "const": "Z2"
        },
        "network": {
          "const": "none"
        },
        "dependencies_lock_sha256": {
          "$ref": "common.schema.json#/$defs/sha256",
          "description": "預先核准、鎖定的相依套件清單；測試只能 import 這些"
        },
        "database": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "engine": {
                  "const": "postgres"
                },
                "disposable": {
                  "const": true
                },
                "migrations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "description": "套用的 repo migration（inventory files 中的路徑）"
                },
                "seed_sha256": {
                  "$ref": "common.schema.json#/$defs/sha256",
                  "description": "合成種子的 hash"
                }
              },
              "required": [
                "engine",
                "disposable",
                "migrations",
                "seed_sha256"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "local_rls 必填（E-W4-TC）；其他種類為 null。只在本地，永遠不連 staging"
        }
      },
      "required": [
        "zone",
        "network",
        "dependencies_lock_sha256",
        "database"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^CTL-[0-9]{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reachability",
              "oracle_can_pass",
              "oracle_can_fail"
            ]
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "control_id",
          "kind",
          "description",
          "steps",
          "expected"
        ]
      },
      "description": "同黑箱的對照：至少一個 reachability（E-TC-CONTROLS）；W4 產生器預設另產生 oracle_can_pass，讓確定性結果是事先登記的解讀"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "STATUS_AND_BODY",
              "STATE_DIFF",
              "TOOL_CHECK",
              "TOOL_CALL_LOG",
              "CANARY",
              "THRESHOLD",
              "DOM_ASSERTION",
              "HUMAN",
              "LLM_GRADER"
            ]
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "必須是 requirement_ids 的子集（E-W4-TC）"
        }
      },
      "required": [
        "types",
        "conditions",
        "requirement_refs"
      ]
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "pass_rule": {
          "type": "string"
        },
        "fail_k_min": {
          "type": "integer",
          "minimum": 1
        },
        "replay_n": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "n",
        "pass_rule",
        "fail_k_min",
        "replay_n"
      ],
      "description": "W4 的測試是確定性的（假模型也是），通常 n＝1"
    },
    "artifact_sha256": {
      "$ref": "common.schema.json#/$defs/sha256",
      "description": "測試檔與對照的內容 hash；testresult.artifact_sha256 必須等於它（E-DERIVED）"
    },
    "access_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "resource",
          "action"
        ]
      },
      "description": "v0.5（09 BL-20）：本測試涵蓋的 G1 存取矩陣格子（role × resource × action）；每格必須在 invariants.yaml 的 access_matrix 中（E-TC-ACCESS-CELL）。不針對存取控制的測試為空陣列"
    }
  },
  "required": [
    "testcase_id",
    "run_id",
    "cluster_ids",
    "requirement_ids",
    "kind",
    "language",
    "framework",
    "test_file",
    "environment",
    "steps",
    "controls",
    "oracle",
    "trials",
    "artifact_sha256",
    "access_cells"
  ]
}
