{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-registry.schema.json",
  "title": "Agent Registry（agents.yaml）",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "models.yaml 的 key；確定性角色為 null"
      },
      "role": {
        "type": "string",
        "enum": [
          "commander",
          "invariant_drafter",
          "reviewer",
          "verifier",
          "cross_family_verifier",
          "test_generator",
          "test_critic",
          "threat_modeler",
          "threat_merger",
          "threat_critic",
          "test_designer",
          "test_implementer",
          "result_analyst",
          "lane_a_reviewer",
          "reporter",
          "aggregator",
          "scope_proxy",
          "executor"
        ],
        "description": "aggregator、scope_proxy、executor 是確定性元件（model 為 null）；lane_a_reviewer 只用於 Lane A（結果最高 UNCORROBORATED）"
      },
      "facets": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "authz",
            "authn_session",
            "injection",
            "data_access",
            "secrets_config",
            "business_logic",
            "llm_integration",
            "file_handling",
            "ssrf_outbound",
            "frontend_client",
            "webhooks_integrations",
            "crypto",
            "cicd_iac"
          ]
        }
      },
      "viewpoint": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "external",
              "merged"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "tools": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "read_slice",
            "read_inventory",
            "read_blackboard",
            "write_blackboard"
          ]
        },
        "description": "reviewer／verifier 只能 read_slice；commander 沒有任何工具（輸入是程式產生的型別化視圖）；invariant_drafter 不能 read_slice（E-AGENT-TOOLS）"
      },
      "fallback_models": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "跨家族 fallback 只允許不參與裁決的角色（reporter）"
      }
    },
    "required": [
      "model",
      "role"
    ]
  },
  "description": "代理登錄。LLM 角色的 model 必須在 models.yaml，且在委任設定該資料等級的允許清單中。"
}
